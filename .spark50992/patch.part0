 import org.apache.commons.text.similarity.LevenshteinDistance
 
@@ -126,20 +127,57 @@ object StringUtils extends Logging {
     funcNames.toSeq
   }
 
+  /** Used internally to terminate one bounded plan-tree rendering operation. */
+  private[sql] class PlanStringLimitReached extends ControlThrowable
+
   /**
    * A string concatenator for plan strings.  Uses length from a configured value, and
    *  prints a warning the first time a plan is truncated.
    */
   class PlanStringConcat extends StringConcat(Math.max(0, SQLConf.get.maxPlanStringLength - 30)) {
+
+    // Once a tree traversal is abandoned, `length` is no longer the full untruncated length.
+    private var stoppedEarly = false
+
+    /**
