     }
   }
 
+  test("bounded plan rendering abandons traversal once the limit is reached") {
+    withSQLConf(SQLConf.MAX_PLAN_STRING_LENGTH.key -> "40") {
+      var fragmentsRendered = 0
+      val concat = new PlanStringConcat()
+      concat.withEarlyStop { append =>
+        (0 until 1000).foreach { i =>
+          fragmentsRendered += 1
+          append(s"plan fragment $i")
+        }
+      }
+      assert(fragmentsRendered === 2)
+      assert(concat.toString === "plan fragm... more characters")
+    }
+  }
+
+  test("bounded plan rendering reports unknown length when the limit is zero") {
+    withSQLConf(SQLConf.MAX_PLAN_STRING_LENGTH.key -> "0") {
+      var fragmentsRendered = 0
+      val concat = new PlanStringConcat()
+      concat.withEarlyStop { append =>
+        (0 until 1000).foreach { i =>
+          fragmentsRendered += 1
+          append(s"plan fragment $i")
+        }
+      }
+      assert(fragmentsRendered === 1)
+      assert(concat.toString === "Truncated plan of unknown length")
+    }
+  }
+
